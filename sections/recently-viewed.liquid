{%- comment -%} Recently viewed — self-contained, populated from localStorage. {%- endcomment -%}
<section class="section" data-recent-section hidden>
  <div class="page-width">
    <div class="section-head"><div class="section-head__titles"><h2>{{ section.settings.heading | default: 'Recently viewed' }}</h2></div></div>
    <div class="carousel" data-carousel data-recently-viewed>
      <button class="carousel__nav carousel__nav--prev" data-carousel-prev aria-label="Previous">{% render 'icon', name: 'chevron-left', size: 18 %}</button>
      <div class="carousel__track" data-carousel-track></div>
      <button class="carousel__nav carousel__nav--next" data-carousel-next aria-label="Next">{% render 'icon', name: 'chevron-right', size: 18 %}</button>
    </div>
  </div>
</section>
<script>
(function () {
  var KEY = "nw-recent";
  var current = {{ product.handle | json }};
  var list = [];
  try { list = JSON.parse(localStorage.getItem(KEY) || "[]"); } catch (e) { list = []; }
  if (current) {
    list = list.filter(function (h) { return h !== current; });
    list.unshift(current);
    list = list.slice(0, 10);
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {}
  }
  var sec = document.querySelector("[data-recent-section]");
  if (!sec) return;
  var track = sec.querySelector("[data-carousel-track]");
  var handles = list.filter(function (h) { return h !== current; }).slice(0, 6);
  if (!handles.length || !track) { sec.hidden = true; return; }
  Promise.all(handles.map(function (h) {
    return fetch("/products/" + h + "?section_id=product-card-ajax")
      .then(function (r) { return r.ok ? r.text() : ""; })
      .catch(function () { return ""; });
  })).then(function (parts) {
    var html = parts.join("");
    if (!html.trim()) { sec.hidden = true; return; }
    track.innerHTML = html;
    if (track.querySelector(".product-card")) { sec.hidden = false; } else { sec.hidden = true; }
  }).catch(function () { sec.hidden = true; });
})();
</script>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" } ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}